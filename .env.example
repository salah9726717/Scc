BOT_TOKEN=123456:ABC...            # BotFather token of @Sophiacompanybot
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres   # Supabase -> Connect -> Session pooler
PUBLIC_URL=https://your-app.onrender.com   # your Render URL (no trailing slash)
WEBHOOK_SECRET=any-long-random-string
ADMIN_ID=                          # optional: your Telegram ID, gets withdraw alerts

FRONTEND_ORIGINS=*                 # Optional: comma-separated Vercel domains; * allows any origin (no cookie auth)
